# Unofficial MODU-C dongle adaptation; see LICENSE.
if SHIELD_MODU_DONGLE || SHIELD_MODU_PERIPHERAL_LEFT || SHIELD_MODU_PERIPHERAL_RIGHT
config ZMK_SPLIT
    default y
endif

if SHIELD_MODU_DONGLE
config ZMK_KEYBOARD_NAME
    default "Modu Dongle"
config ZMK_SPLIT_ROLE_CENTRAL
    default y
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2
config BT_MAX_CONN
    default 7
config BT_MAX_PAIRED
    default 7
endif

if SHIELD_MODU_PERIPHERAL_LEFT || SHIELD_MODU_PERIPHERAL_RIGHT
config ZMK_SPLIT_ROLE_CENTRAL
    default n
endif
