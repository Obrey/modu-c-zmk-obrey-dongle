menu "MODU-C dongle status additions"
config MODU_PERIPHERAL_STATUS_LED
    bool "Show the actual keyboard-to-dongle BLE link on the keyboard LED"
    depends on ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL && ZMK_SPLIT_BLE && PWM
    default n

config MODU_STATUS_LED_BRIGHTNESS
    int "Connected/disconnected status LED brightness (percent)"
    depends on MODU_PERIPHERAL_STATUS_LED
    range 1 100
    default 12

config MODU_DONGLE_STATUS_SCREEN
    bool "Original Corne dongle display with Mac modifier symbols"
    depends on ZMK_DISPLAY && ZMK_SPLIT_ROLE_CENTRAL && ZMK_SPLIT_BLE
    depends on ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    select LV_USE_LABEL
    select LV_USE_IMAGE
    select LV_USE_CANVAS
    select LV_USE_ANIMIMG
    select LV_USE_ANIMATION
    select LV_USE_LINE
    select LV_FONT_UNSCII_8
    select ZMK_WPM
    default n

if MODU_DONGLE_STATUS_SCREEN

# Same UI options as englmaxi/zmk-dongle-display. Its Kconfig declarations are
# normally gated by SHIELD_DONGLE_DISPLAY; we compile its widgets in our shield
# to apply narrow compatibility fixes without modifying the fetched project.
config ZMK_DONGLE_DISPLAY_MAC_MODIFIERS
    bool "Use Control / Option / Command / Shift symbols"
    default y
config ZMK_DONGLE_DISPLAY_DONGLE_BATTERY
    bool "Include dongle battery row"
    default y
config ZMK_DONGLE_DISPLAY_MODIFIERS
    bool "Display active modifier symbols"
    default y
config ZMK_DONGLE_DISPLAY_BONGO_CAT
    bool "Keep original Bongo Cat widget"
    default y
config ZMK_DONGLE_DISPLAY_LAYER
    bool "Display current layer"
    default y
config ZMK_DONGLE_DISPLAY_LAYER_NAME_SCROLL_WIDTH
    int "Layer name width"
    default 50
config ZMK_DONGLE_DISPLAY_LAYER_TEXT_ALIGN
    string "Layer name alignment"
    default "left"
config ZMK_DONGLE_DISPLAY_WPM
    bool "Show WPM counter (original default is off)"
    default n
config ZMK_DONGLE_DISPLAY_WPM_DISABLED_LAYERS
    string "WPM excluded layers"
    default ""

config MODU_DONGLE_HAS_BATTERY
    bool "Read dongle battery sensor for D row"
    depends on ZMK_BATTERY_REPORTING && ZMK_DONGLE_DISPLAY_DONGLE_BATTERY
    default y
    help
      Uses the board's zmk,battery sensor, not a fabricated percentage.
      Only meaningful if a real battery is connected to a valid measurement
      circuit. For a USB-only dongle set this to n; D then reads USB or EXT.
endif
config MODU_BATTERY_TELEMETRY_PERIPHERAL
    bool "Report measured voltage, sensor status and hand identity to the dongle"
    depends on ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL && ZMK_BLE
    depends on ZMK_BATTERY_REPORTING && SENSOR
    default n
    help
      A read-only encrypted BLE diagnostic service. Preserves the original
      battery sensor pins, voltage-divider ratio and normal BAS reporting.

config MODU_BATTERY_TELEMETRY_CENTRAL
    bool "Read both keyboard sensor results, including voltage and errors"
    depends on ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL && ZMK_BLE
    select BT_GATT_CLIENT
    default n
    help
      Periodically polls the read-only diagnostic characteristic on each
      existing split link. Does not connect to additional devices.
config MODU_BATTERY_ACTIVE_INTERVAL
    int "Active keyboard diagnostic sample interval in seconds"
    depends on MODU_BATTERY_TELEMETRY_PERIPHERAL
    range 30 120
    default 60

config MODU_BATTERY_IDLE_INTERVAL
    int "Idle keyboard diagnostic sample interval in seconds"
    depends on MODU_BATTERY_TELEMETRY_PERIPHERAL
    range 180 600
    default 300
    help
      Keep a sparse measurement while idle, including during charging.
      GATT reads return cached samples and do not force idle ADC sampling.
endmenu
