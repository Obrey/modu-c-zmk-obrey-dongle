+# MODU-C v7: connected standby, NOT untested system-off sleep.
+# Vendor PMW3610 / left key scanner use polling due to GPIO interrupt issues.
+# Preserve polling, all pin assignments and the original battery conversion.
+CONFIG_ZMK_IDLE_TIMEOUT=30000
+CONFIG_ZMK_SLEEP=n
+CONFIG_ZMK_BATTERY_REPORT_INTERVAL=60
+CONFIG_MODU_STATUS_LED_BRIGHTNESS=6
+CONFIG_MODU_BATTERY_ACTIVE_INTERVAL=60
