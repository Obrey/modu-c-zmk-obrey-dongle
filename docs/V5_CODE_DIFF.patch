+# Use the custom screen's own styles. Built-in widget themes add borders,
+# padding and scrollbars to upstream output/modifier containers. These flags
+# do NOT control monochrome pixels: keep LV_COLOR_DEPTH_1 and buffers above.
+CONFIG_LV_USE_THEME_MONO=n
+CONFIG_LV_USE_THEME_DEFAULT=n
+CONFIG_LV_USE_THEME_SIMPLE=n
 CONFIG_LV_FONT_UNSCII_8=y
